 expiry DateTime
 status String @default("Draft")
 mitigationBankId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([mitigationBankId])
 linkedMitigationBankId MitigationBank @relation("FinancialAssurance_mitigationBankId", fields: [mitigationBankId], references: [id], onDelete: Restrict)
}

model OperationalTask {
 id String @id @default(cuid())
 title String
 owner String
 priority String
 startAt DateTime
 dueAt DateTime
 done Boolean
 notes String?
 status String @default("Draft")
 mitigationBankId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([mitigationBankId])
 linkedMitigationBankId MitigationBank @relation("OperationalTask_mitigationBankId", fields: [mitigationBankId], references: [id], onDelete: Restrict)
}

model RuleVersion {
 id String @id @default(cuid())
 title String
 jurisdiction String
 version String
 effectiveAt DateTime
 expiresAt DateTime?
 sourceUrl String
 requirementText String
 status String @default("Draft")
 mitigationBankId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([mitigationBankId])
 linkedMitigationBankId MitigationBank @relation("RuleVersion_mitigationBankId", fields: [mitigationBankId], references: [id], onDelete: Restrict)
}

model DocumentRequirement {
 id String @id @default(cuid())
 title String
 category String
 requiredBy DateTime
 sourceReference String
 evidenceReference String?
 reviewNotes String?
 status String @default("Draft")
 mitigationBankId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([mitigationBankId])
 linkedMitigationBankId MitigationBank @relation("DocumentRequirement_mitigationBankId", fields: [mitigationBankId], references: [id], onDelete: Restrict)
}